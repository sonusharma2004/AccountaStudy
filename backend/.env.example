# ============================================
# AccountaStudy FastAPI Backend — Environment
# Copy to .env and fill in real values
# ============================================

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://localhost:5432/accountastudy

# Neon (production) — note the required sslmode
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/accountastudy?sslmode=require

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_DAYS=7

MAX_FILE_SIZE=10485760
ENVIRONMENT=development
PORT=5001
